VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_TUNNEL_GATEWAY_URL=
VITE_TUNNEL_GATEWAY_KEY=

# Sentry — frontendowy monitoring błędów. Puste = wyłączone (np. lokalnie).
VITE_SENTRY_DSN=
# Etykieta środowiska w Sentry (domyślnie tryb Vite: production/development).
VITE_SENTRY_ENVIRONMENT=
# Tylko build (CI/Vercel) — wgrywanie source map do czytelnych stack trace.
# Ustaw w środowisku builda. NIE prefiksuj przez VITE_ (to sekrety build-time).
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
